{
  email {$ACME_EMAIL}
  # Empty on the server. Set CADDY_LOCAL_CERTS=local_certs in .env to run the stack on your own
  # machine with Caddy's local certificate authority, since Let's Encrypt cannot reach it.
  {$CADDY_LOCAL_CERTS}
}

{$ROOT_DOMAIN} {
  reverse_proxy landing:3000
}

pdf.{$ROOT_DOMAIN} {
  handle /api/* {
    reverse_proxy pdf-backend:8080
  }

  handle /actuator/* {
    reverse_proxy pdf-backend:8080
  }

  handle {
    reverse_proxy pdf-frontend:3000
  }
}

dev.{$ROOT_DOMAIN} {
  reverse_proxy developer:3000
}

images.{$ROOT_DOMAIN} {
  reverse_proxy images:3000
}

storage.{$ROOT_DOMAIN} {
  reverse_proxy minio:9000
}
