ROOT_DOMAIN=utilfoundry.com
ACME_EMAIL=ops@utilfoundry.com
POSTGRES_DB=pdf_platform
POSTGRES_USER=pdf_user
POSTGRES_PASSWORD=replace-with-a-long-random-secret
S3_ACCESS_KEY=replace-with-a-unique-access-key
S3_SECRET_KEY=replace-with-a-long-random-secret
S3_BUCKET=pdf-files
PROCESSOR_TOKEN=replace-with-a-long-random-secret
RATE_LIMIT_PER_MINUTE=20

# apps/admin: the feedback + visitor-analytics service behind admin.<ROOT_DOMAIN>, and
# its own dedicated Postgres (separate from POSTGRES_* above, which is PDF's database).
ADMIN_POSTGRES_DB=admin_platform
ADMIN_POSTGRES_USER=admin_user
ADMIN_POSTGRES_PASSWORD=replace-with-a-long-random-secret
# The one password every admin uses to sign in at admin.<ROOT_DOMAIN>/admin.
ADMIN_PASSWORD=replace-with-a-long-random-secret
# Signs the admin login session cookie. Generate with `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Local testing only: serve the real hostnames on this machine with Caddy's own certificate
# authority instead of Let's Encrypt. Leave this unset on the server.
# CADDY_LOCAL_CERTS=local_certs

# Where "Contact", "Have feedback?" and "Need a feature?" point across the apps. Unset uses
# mailto:support@utilfoundry.com, which is also the address in every privacy policy and terms
# page, so that mailbox has to work. Set this to a form URL to send people there instead.
# CONTACT_URL=
