# Local dev: apps/admin/docker-compose.yml starts a Postgres container matching this.
DATABASE_URL=postgres://admin_user:admin_password@127.0.0.1:5434/admin_platform

# One shared password for the /admin dashboard, and the secret used to sign the
# session cookie issued on login. Generate a long random value for both in production,
# e.g. `openssl rand -hex 32`.
ADMIN_PASSWORD=replace-with-a-long-random-secret
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Comma-separated. In development, any http://localhost:<port> origin is allowed
# regardless of this value, so it's only required in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3021

# RATE_LIMIT_FEEDBACK_PER_MINUTE=10
# RATE_LIMIT_VISIT_PER_MINUTE=60
# RATE_LIMIT_LOGIN_PER_MINUTE=10
