# Local dev: `docker compose up -d` in this folder starts a Postgres matching this.
DATABASE_URL=postgres://admin_user:admin_password@127.0.0.1:5434/admin_platform

# One shared password for the /admin dashboard, and the secret that signs the session
# cookie issued on sign-in. In production the service refuses to start unless the password
# is at least 12 characters, the secret at least 32 (`openssl rand -hex 32`), neither is a
# placeholder like these, and they differ. Changing either signs everyone out.
ADMIN_PASSWORD=replace-with-a-long-random-secret
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Comma-separated sites allowed to send feedback and page views. In development any
# http://localhost:<port> origin is also allowed, so this only matters in production,
# where each entry must be an https:// origin with no path.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3021

# Days of page-view history to keep; older rows are deleted once a day. Feedback is kept
# until someone deletes it in the dashboard.
# VISIT_RETENTION_DAYS=395

# Requests per minute. Per client address, except LOGIN_GLOBAL, which caps sign-in
# attempts from everyone together (one shared password makes spread-out guessing the risk).
# RATE_LIMIT_FEEDBACK_PER_MINUTE=10
# RATE_LIMIT_VISIT_PER_MINUTE=60
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# RATE_LIMIT_LOGIN_GLOBAL_PER_MINUTE=60
